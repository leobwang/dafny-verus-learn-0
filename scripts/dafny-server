#!/usr/bin/env python3
"""dafny-server — the course's one way to start `dafny server` (QPLAN §30 Q56).

Usage:
  scripts/dafny-server [--runtime S]
      Run Dafny's language server, talking the Language Server Protocol on this
      process's stdin and stdout, with dvl's scrubbed environment. The server
      runs from a scratch copy of the Dafny install on PATH (Δ33: it writes a log
      file into its install directory on every start, so the learner's install
      is never the server's), with the pinned solver, the course resource limit
      and the pinned --cores (dvl.dafny.server_argv). S (default 900, at most the
      pinned wall clock) is the server's lifetime: it is killed after S seconds
      whoever still waits for it, because a server whose stdin reaches end of
      file does not exit on its own (VERSIONS.md §1.1), and when this process
      dies (dvl.common.run_attached). There is no memory cap (DELTAS Δ503, D78).
      A client ends a session with LSP `shutdown` and `exit`, then kills the
      process group (fvh.lsp.stop_server).
  scripts/dafny-server --argv
      Print the server's command line (one argument per line) and exit 0.

Exit codes: the server's own once it runs (124 after S seconds); 3 a usage
error or no usable toolchain. Learner code reaches the server
only through fvh.lsp.start_server, which runs this script.
"""

import argparse
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))

from dvl import common, dafny  # noqa: E402


def main(argv=None):
    ap = argparse.ArgumentParser(prog="dafny-server", allow_abbrev=False)
    ap.add_argument("--runtime", type=int, default=900)
    ap.add_argument("--argv", action="store_true")
    a = ap.parse_args(argv)
    p = dafny.pins()
    if not 1 <= a.runtime <= int(p["wall_clock_s"]):
        print(f"dafny-server: --runtime must be 1 to {p['wall_clock_s']} seconds", file=sys.stderr)
        return 3
    try:
        common.toolchain("dafny")
        server = [str(x) for x in dafny.server_argv()]
    except (common.DvlError, common.ToolchainError) as e:
        print(f"dafny-server: refused: {e}", file=sys.stderr)
        return 3
    if a.argv:
        print("\n".join(server))
        return 0
    sys.stdout.flush()
    try:
        return common.run_attached(server, a.runtime, common.default_env())
    except common.DvlError as e:
        print(f"dafny-server: refused: {e}", file=sys.stderr)
        return 3

if __name__ == "__main__":
    sys.exit(main())
