# expected/R10.counts — Δ11 count pins for R10: per verification unit, the
# reference twin's gate count and the learner-declared declarations with a contract
# that must run in the learner's gate (min_verified is one per pinned symbol); per
# file (schema 2), its shipped state in the learner loop: verdict, tool-counted
# holes and errors (the counts its header and the chapter state).
# Written by `scripts/vcheck --ref --pin-counts R10` (author-only) from the twins
# and the learner files as shipped; checked by `vcheck --gate` (a pinned symbol that
# ran no task, or a count below min_verified, fails the gate), `vcheck --ref` (a
# stale pin), `vcheck --shipped` (a file no longer in its shipped state) and
# `pins.py --ci` (a missing, stale or malformed pin). Never edit by hand.
schema = 2
module = "R10"

[[unit]]
path = "dafny/R/R10_TypeInvariants/std"
lang = "dafny"
reference_verified = 71
min_verified = 6
symbols = ["R10_TypeInvariants.CatPacketR10", "R10_TypeInvariants.NormIdempotentR10", "R10_TypeInvariants.NormalFixedR10", "R10_TypeInvariants.NormalizePacketR10", "R10_TypeInvariants.ReplaceRightR10", "R10_TypeInvariants.TryPacketR10"]

