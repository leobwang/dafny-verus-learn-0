# expected/R11.counts — Δ11 count pins for R11: per verification unit, the
# reference twin's gate count and the learner-declared declarations with a contract
# that must run in the learner's gate (min_verified is one per pinned symbol); per
# file (schema 2), its shipped state in the learner loop: verdict, tool-counted
# holes and errors (the counts its header and the chapter state).
# Written by `scripts/vcheck --ref --pin-counts R11` (author-only) from the twins
# and the learner files as shipped; checked by `vcheck --gate` (a pinned symbol that
# ran no task, or a count below min_verified, fails the gate), `vcheck --ref` (a
# stale pin), `vcheck --shipped` (a file no longer in its shipped state) and
# `pins.py --ci` (a missing, stale or malformed pin). Never edit by hand.
schema = 2
module = "R11"

[[unit]]
path = "dafny/R/R11_Theory/std"
lang = "dafny"
reference_verified = 77
min_verified = 12
symbols = ["R11_Kernel.CheckCertificateR11", "R11_Kernel.CheckSoundR11", "R11_Kernel.DirectCompleteR11", "R11_Kernel.PackEvidenceR11", "R11_Search.SearchCatR11", "R11_Search.SearchR11", "R11_Search.SearchStarR11", "R11_Streaming.PrefixMatchesR11", "R11_Streaming.ResidualObserveR11", "R11_Streaming.ResidualStartR11", "R11_Streaming.ResidualStepR11", "R11_WpReview.WpIndexStepR11"]

