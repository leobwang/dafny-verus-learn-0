# expected/R13.counts — Δ11 count pins for R13: per verification unit, the
# reference twin's gate count and the learner-declared declarations with a contract
# that must run in the learner's gate (min_verified is one per pinned symbol); per
# file (schema 2), its shipped state in the learner loop: verdict, tool-counted
# holes and errors (the counts its header and the chapter state).
# Written by `scripts/vcheck --ref --pin-counts R13` (author-only) from the twins
# and the learner files as shipped; checked by `vcheck --gate` (a pinned symbol that
# ran no task, or a count below min_verified, fails the gate), `vcheck --ref` (a
# stale pin), `vcheck --shipped` (a file no longer in its shipped state) and
# `pins.py --ci` (a missing, stale or malformed pin). Never edit by hand.
schema = 2
module = "R13"

[[unit]]
path = "dafny/R/R13_Pipelines/std"
lang = "dafny"
reference_verified = 65
min_verified = 4
symbols = ["R13_Repairs.ClampIndexR13", "R13_Repairs.PairWitnessR13", "R13_Repairs.RangeFitsR13", "R13_Repairs.SaturatingSumR13"]

[[unit]]
path = "verus/r/r13_pipelines"
lang = "verus"
reference_verified = 4
min_verified = 4
symbols = ["clamp_index_r13", "pair_witness_r13", "range_fits_r13", "saturating_sum_r13"]

[[file]]
path = "dafny/R/R13_Pipelines/std/R13_Pipelines.dfy"
role = "exercise"
verdict = "verified"
holes = 4
errors = 0

[[file]]
path = "verus/r/r13_pipelines/src/lib.rs"
role = "exercise"
verdict = "verified"
holes = 4
errors = 0

[[file]]
path = "dafny/R/R13_Pipelines/agent/R13_AgentForensic.dfy"
role = "agent"
verdict = "verified"
holes = 1
errors = 0

[[file]]
path = "verus/r/r13_pipelines/src/agent.rs"
role = "agent"
verdict = "verified"
holes = 1
errors = 0
