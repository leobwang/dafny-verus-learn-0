# expected/R08.counts — Δ11 count pins for R08: per verification unit, the
# reference twin's gate count and the learner-declared declarations with a contract
# that must run in the learner's gate (min_verified is one per pinned symbol); per
# file (schema 2), its shipped state in the learner loop: verdict, tool-counted
# holes and errors (the counts its header and the chapter state).
# Written by `scripts/vcheck --ref --pin-counts R08` (author-only) from the twins
# and the learner files as shipped; checked by `vcheck --gate` (a pinned symbol that
# ran no task, or a count below min_verified, fails the gate), `vcheck --ref` (a
# stale pin), `vcheck --shipped` (a file no longer in its shipped state) and
# `pins.py --ci` (a missing, stale or malformed pin). Never edit by hand.
schema = 2
module = "R08"

[[unit]]
path = "dafny/R/R08_Abstraction/std"
lang = "dafny"
reference_verified = 40
min_verified = 7
symbols = ["R08_Class.MatchWord", "R08_Class.WordLanguage", "R08_Derivative.MatchWord", "R08_Literal.MatchWord", "R08_LiteralClient.ReadModel", "R08_Opacity.RevealResidual", "R08_Opacity.RevealWord"]

[[unit]]
path = "verus/r/r08_abstraction"
lang = "verus"
reference_verified = 6
min_verified = 6
symbols = ["ClassEngine::match_word", "DerivEngine::match_word", "LiteralEngine::match_word", "read_model", "reveal_residual", "reveal_word"]

[[file]]
path = "dafny/R/R08_Abstraction/std/R08_Abstraction.dfy"
