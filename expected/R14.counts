# expected/R14.counts — Δ11 count pins for R14: per verification unit, the
# reference twin's gate count and the learner-declared declarations with a contract
# that must run in the learner's gate (min_verified is one per pinned symbol); per
# file (schema 2), its shipped state in the learner loop: verdict, tool-counted
# holes and errors (the counts its header and the chapter state).
# Written by `scripts/vcheck --ref --pin-counts R14` (author-only) from the twins
# and the learner files as shipped; checked by `vcheck --gate` (a pinned symbol that
# ran no task, or a count below min_verified, fails the gate), `vcheck --ref` (a
# stale pin), `vcheck --shipped` (a file no longer in its shipped state) and
# `pins.py --ci` (a missing, stale or malformed pin). Never edit by hand.
schema = 2
module = "R14"

[[unit]]
path = "dafny/R/R14_Smt/std"
lang = "dafny"
reference_verified = 52
min_verified = 5
symbols = ["R14_Mechanics.ClearLowBitR14", "R14_Mechanics.OddSquareR14", "R14_Mechanics.OddTraceR14", "R14_Mechanics.PrefixCapR14", "R14_Mechanics.PrefixMassR14"]

[[unit]]
path = "verus/r/r14_smt"
lang = "verus"
reference_verified = 8
min_verified = 5
symbols = ["clear_low_bit_r14", "odd_square_r14", "odd_trace_r14", "prefix_cap_r14", "prefix_mass_r14"]

[[file]]
path = "dafny/R/R14_Smt/std/R14_Smt.dfy"
role = "exercise"
verdict = "verified"
holes = 3
errors = 0

