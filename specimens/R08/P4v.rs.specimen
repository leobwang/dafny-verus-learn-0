fn receiver_obligations(word:&Vec<char>)
 requires word@ == seq!['k'],
{
 let left=Literal { c:'k' };
 let right=Literal { c:'m' };
 let b=left.run(word);
 assert(b == left.language(word@)); // [a]
 assert(b == right.language(word@)); // [b]
 assert(b); // [c]
}
}
