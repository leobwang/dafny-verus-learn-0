use vstd::prelude::*;
verus! {
// Printed local interface for this complete prediction; no earlier learner file.
pub trait LiteralContract {
 spec fn language(&self,word:Seq<char>)->bool;
 fn run(&self,word:&Vec<char>)->(b:bool) ensures b == self.language(word@);
}
pub struct Literal { pub c:char }
impl LiteralContract for Literal {
 open spec fn language(&self,word:Seq<char>)->bool { word == seq![self.c] }
 fn run(&self,word:&Vec<char>)->(b:bool)
  ensures b == self.language(word@),
 {
  let b = word.len()==1 && word[0]==self.c;
  proof { if b { assert(word@ =~= seq![self.c]); } }
  b
 }
}
