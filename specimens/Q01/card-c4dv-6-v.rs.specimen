// Card demo Q01.C4dv (false friends), row 6 (`==>`), Verus side. Open it only after Q01's
// predictions are recorded. Run `scripts/vcheck specimens/Q01/card-c4dv-6-v.rs.specimen` and compare with
// the Dafny side, `specimens/Q01/card-c4dv-6-d.dfy.specimen`.
// after: Q01.P8dv
use vstd::prelude::*;

verus! {

fn implies_demo(a: bool, b: bool) -> (c: bool)
    ensures
        c == (a ==> b),
{
    a ==> b
}

} // verus!
