// Card demo Q01.C4dv (false friends), row 4 (`old`), Verus side. Open it only after Q01's
// predictions are recorded. Run `scripts/vcheck specimens/Q01/card-c4dv-4-v.rs.specimen` and compare with
// the Dafny side, `specimens/Q01/card-c4dv-4-d.dfy.specimen`.
// after: Q01.P8dv
use vstd::prelude::*;

verus! {

fn old_demo(x: u64) -> (y: u64)
    requires
        x < 100,
    ensures
        y == old(x) + 1,
{
    x + 1
}

} // verus!
