// Card demo Q01.C4dv (false friends), row 6 (`==>`), Dafny side. Open it only after Q01's
// predictions are recorded. Run `scripts/vcheck specimens/Q01/card-c4dv-6-d.dfy.specimen` and compare with
// the Verus side, `specimens/Q01/card-c4dv-6-v.rs.specimen`.
module Q01_C4dv6d {
  method ImpliesDemo(a: bool, b: bool) returns (c: bool)
    ensures c == (a ==> b)
  {
    c := a ==> b;
  }
}
