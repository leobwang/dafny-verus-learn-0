// Card demo Q01.C4dv (false friends), row 2 (`assert`), Verus side. Open it only after Q01's
// predictions are recorded. Run `scripts/vcheck specimens/Q01/card-c4dv-2-v.rs.specimen` and compare with
// the Dafny side, `specimens/Q01/card-c4dv-2-d.dfy.specimen`.
// after: Q01.P8dv
use vstd::prelude::*;

verus! {

spec fn identity(x: nat) -> nat {
    assert(x + 0 == x);
    x
}

} // verus!
