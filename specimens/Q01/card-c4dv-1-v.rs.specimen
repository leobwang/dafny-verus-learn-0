// Card demo Q01.C4dv (false friends), row 1 (`calc`), Verus side. Open it only after Q01's
// predictions are recorded. Run `scripts/vcheck specimens/Q01/card-c4dv-1-v.rs.specimen` and compare with
// the Dafny side, `specimens/Q01/card-c4dv-1-d.dfy.specimen`.
// after: Q01.P8dv
use vstd::prelude::*;

verus! {

proof fn calc_demo(x: int)
    ensures
        x + 0 == x,
{
    calc! {
        (==)
        x + 0; {}
        x;
    }
}

} // verus!
