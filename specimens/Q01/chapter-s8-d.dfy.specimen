method Step(x: int) returns (y: int)
  requires x < 4
  ensures y < 9
{
  y := 2 * x + 1;
}

method StepLoose(x: int) returns (y: int)
  requires x < 5
  ensures y < 9
{
  y := 2 * x + 1;
}

