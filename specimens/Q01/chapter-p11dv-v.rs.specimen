use vstd::prelude::*;

verus! {

fn weak_max(a: u64, b: u64) -> (m: u64)
    requires
        a <= 1000,
        b <= 1000,
    ensures
        m >= a && m >= b,
{
    a + b
}

fn weak_max_check() {
    let m = weak_max(3, 7);
    assert(m == 7);
}

} // verus!

