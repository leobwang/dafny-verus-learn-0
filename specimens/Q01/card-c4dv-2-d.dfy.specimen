// Card demo Q01.C4dv (false friends), row 2 (`assert`), Dafny side. Open it only after Q01's
// predictions are recorded. Run `scripts/vcheck specimens/Q01/card-c4dv-2-d.dfy.specimen` and compare with
// the Verus side, `specimens/Q01/card-c4dv-2-v.rs.specimen`.
module Q01_C4dv2d {
  function Identity(x: nat): nat
  {
    assert x + 0 == x;
    x
  }
}
