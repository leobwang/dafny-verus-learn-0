use vstd::prelude::*;

verus! {

fn step(x: u64) -> (y: u64)
    requires
        x < 4,
    ensures
        y < 9,
{
    2 * x + 1
}

fn step_loose(x: u64) -> (y: u64)
    requires
        x < 5,
    ensures
        y < 9,
{
    2 * x + 1
}

} // verus!

