// Card demo Q01.C1v (`ensures`), the failure half. The success half is `inc` in
// verus/q/q01_hello/src/lib.rs; this copy returns the wrong value. Run it with
// `scripts/vcheck specimens/Q01/card-c1v.rs.specimen`; the EXPECT line at the end pins
// the message the verifier gives (line and fragment).
// after: Q01.P8dv
use vstd::prelude::*;

verus! {

pub fn inc(x: u64) -> (y: u64)
    requires
        x < 100,
    ensures
        y == x + 1,
{
    x
}

} // verus!
// EXPECT @14 "postcondition not satisfied"
