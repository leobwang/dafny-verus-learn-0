// the message the verifier gives (line and fragment).
// after: Q04.P6v
use vstd::prelude::*;

verus! {

pub proof fn lemma_product_le_by_nl(x: nat, y: nat, xb: nat, yb: nat)
    requires
        x <= xb,
        y <= yb,
    ensures
        x * y <= xb * yb,
{
    assert(x * y <= xb * yb) by (nonlinear_arith);
}

} // verus!
