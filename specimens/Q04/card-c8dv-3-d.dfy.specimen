module Q04_CardC8dv3D {
  function Double(n: nat): nat
    decreases n
  {
    if n == 0 then 0 else Double(n - 1) + 2
  }

  lemma {:induction false} DoubleTwiceManual(n: nat)
    ensures Double(n) == 2 * n
    decreases n
  {
  }

  lemma DoubleTwiceDefault(n: nat)
    ensures Double(n) == 2 * n
    decreases n
  {
  }
}
