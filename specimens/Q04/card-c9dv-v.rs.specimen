// Card Q04.C9dv (divergence), demo v (Verus). Open it only after your Q04 predictions are
// committed, then run `scripts/vcheck specimens/Q04/card-c9dv-v.rs.specimen` and compare
// with specimens/Q04/card-c9dv-d.dfy.specimen.
use vstd::prelude::*;

verus! {

pub proof fn lemma_scale_le(a: nat, b: nat, w: nat)
    requires
        a <= b,
    ensures
        a * w <= b * w,
{
    vstd::arithmetic::mul::lemma_mul_inequality(a as int, b as int, w as int);
}

} // verus!
