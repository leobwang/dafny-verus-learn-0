use vstd::prelude::*;

verus! {

fn triple(x: u64) -> (r: u64)
    requires
        x < 1000,
    ensures
        r == 3 * x,
{
    x * 3
}

proof fn lemma_pos(x: int)
    requires
        x > 0,
    ensures
        2 * x > x,
{
}

fn call_c(x: u64) {
    if x > 0 {
        lemma_pos(x as int);
    }
}

} // verus!
