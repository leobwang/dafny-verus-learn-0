/*!
# RG_A1 — regex spine, layer A1 (PROVIDED, complete)

Frozen infrastructure, not an exercise. Imported by R02–R16: definitions only; no module lemma is supplied.
Use only the layer chain declared by your module. No earlier learner file is imported.
PLAN.md §2.2 and §2.4 define this layer boundary.
*/
module RG_A1_Re {
  datatype Re = Empty | Eps | Chr(c: char) | Alt(a: Re, b: Re) | Cat(a: Re, b: Re) | Star(r: Re)

  // Whole-string semantics by splits. A Star iteration consumes a non-empty chunk.
  // Ghost, so no exec item can answer itself by calling it.
  ghost predicate Matches(r: Re, s: seq<char>)
    decreases r, |s|
  {
    match r
    case Empty => false
    case Eps => s == []
    case Chr(c) => s == [c]
    case Alt(a, b) => Matches(a, s) || Matches(b, s)
    case Cat(a, b) => exists i | 0 <= i <= |s| :: Matches(a, s[..i]) && Matches(b, s[i..])
    case Star(a) => s == [] || exists i | 0 < i <= |s| :: Matches(a, s[..i]) && Matches(Star(a), s[i..])
  }

  predicate Nullable(r: Re)
    decreases r
  {
    match r
    case Empty => false
    case Eps => true
    case Chr(_) => false
    case Alt(a, b) => Nullable(a) || Nullable(b)
    case Cat(a, b) => Nullable(a) && Nullable(b)
    case Star(_) => true
  }

  function NodeCount(r: Re): nat
    decreases r
  {
    match r
    case Empty => 1
    case Eps => 1
    case Chr(_) => 1
    case Alt(a, b) => 1 + NodeCount(a) + NodeCount(b)
    case Cat(a, b) => 1 + NodeCount(a) + NodeCount(b)
    case Star(a) => 1 + NodeCount(a)
  }

  // The regex read backwards.
  function Backwards(r: Re): Re
    decreases r
  {
    match r
    case Empty => Empty
    case Eps => Eps
    case Chr(c) => Chr(c)
    case Alt(a, b) => Alt(Backwards(a), Backwards(b))
    case Cat(a, b) => Cat(Backwards(b), Backwards(a))
    case Star(a) => Star(Backwards(a))
  }

  // The string read backwards.
  function BackwardsStr(s: seq<char>): seq<char>
    decreases |s|
  {
    if s == [] then [] else BackwardsStr(s[1..]) + [s[0]]
  }
}

// item: R06.P4d obligation
// One-directional invariant. Derivative correctness is supplied explicitly
// as a premise, so this prediction does not depend on your unfinished H1.
// The loop uses that relation at each step, without importing an H1 proof.
// SLOT: FAILS ???
module R06_LoopPrediction {
  import opened RG_A1_Re
function Deriv(r: Re, c: char): Re
    decreases r
  {
    match r
    case Empty => Empty
    case Eps => Empty
    case Chr(d) => if c == d then Eps else Empty
    case Alt(a, b) => Alt(Deriv(a, c), Deriv(b, c))
    case Cat(a, b) =>
      if Nullable(a) then Alt(Cat(Deriv(a, c), b), Deriv(b, c)) else Cat(Deriv(a, c), b)
    case Star(a) => Cat(Deriv(a, c), Star(a))
  }
  lemma OneWayLoopR06(r: Re,s: seq<char>)
    requires forall q: Re,c: char,t: seq<char> :: Matches(Deriv(q,c),t) <==> Matches(q,[c]+t)
  {
    var cur := r;var i := 0;
    assert s[0..] == s;
    assert Matches(r,s) ==> Matches(cur,s[i..]); // [a]
    while i < |s|
      invariant 0 <= i <= |s|
      invariant Matches(r,s) ==> Matches(cur,s[i..])
      decreases |s|-i
    {
      assert Matches(Deriv(cur,s[i]),s[i+1..]) <==> Matches(cur,[s[i]]+s[i+1..]);
      assert [s[i]]+s[i+1..] == s[i..];
      cur := Deriv(cur,s[i]);i := i+1;
      assert Matches(r,s) ==> Matches(cur,s[i..]); // [b]
    }
    assert s[i..] == [];
    assert Matches(cur,[]) ==> Matches(r,s); // [c]
    assert Matches(r,s) ==> Matches(cur,[]); // [d]
  }
}
