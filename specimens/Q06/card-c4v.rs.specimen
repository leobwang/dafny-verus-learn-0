// Demo for card Q06.C4v (write:property-test), the failure half. The success half is
// `all_below` in verus/q/q06_machine/src/lib.rs; here the checker's postcondition is
// one-sided, so a body that always answers `false` verifies, and a caller learns nothing
// from a correct candidate. Run it with `scripts/vcheck specimens/Q06/card-c4v.rs.specimen`;
// the EXPECT line pins the message the verifier gives (line and fragment).
// EXPECT @23 "assertion failed"
use vstd::prelude::*;

verus! {

pub fn all_below(xs: &Vec<u64>, bound: u64) -> (ok: bool)
    ensures
        ok ==> (forall|k: int| 0 <= k < xs.len() ==> #[trigger] xs@[k] < bound),
{
    false
}

pub fn clip_checked() {
    let mut xs: Vec<u64> = Vec::new();
    xs.push(0);
    xs.push(999);
    let ok = all_below(&xs, 1000);
    assert(ok);
}

} // verus!
