// Demo for card Q06.C2v (write:opaque-reveal), the failure half. The success half is
// `lemma_mid_between` in verus/q/q06_machine/src/lib.rs; here the reveal sits inside an
// `assert … by` about another instance, and the postcondition needs the body after it.
// Run it with `scripts/vcheck specimens/Q06/card-c2v.rs.specimen`; the EXPECT line pins
// the message the verifier gives (line and fragment).
// after: Q06.P5dv
// EXPECT @21 "postcondition not satisfied"
use vstd::prelude::*;

verus! {

#[verifier::opaque]
pub open spec fn mid(a: nat, b: nat) -> nat {
    (a + b) / 2
}

pub proof fn lemma_mid_between(a: nat, b: nat)
    requires
        a <= b,
    ensures
        a <= mid(a, b) <= b,
{
    assert(mid(a, a) == a) by {
        reveal(mid);
    }
}

} // verus!
