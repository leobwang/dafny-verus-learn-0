// Demo for card Q06.C6dv (divergence), the Dafny column. Open it only after
// every prediction of Q06 is recorded (scripts/firsttry.sh Q06 --check).
// Its pinned run is `scripts/vcheck` (the sidecar's command); run
// `scripts/vaudit` on it too.
// after: Q06.P8dv
module Q06_CardC6d {
  import Mul = Std.Arithmetic.Mul

  lemma Commute(x: int, y: int)
    ensures x * y == y * x
  {
    Mul.LemmaMulIsCommutative(x, y);
  }
}
