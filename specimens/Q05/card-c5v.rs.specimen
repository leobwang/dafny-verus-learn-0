// Demo for card Q05.C5v (write:mut-ref), the failure half: a caller of a `&mut self`
// method that returns `Err`, and a postcondition with no clause about `hits`. Run it with
// `scripts/vcheck specimens/Q05/card-c5v.rs.specimen`; the EXPECT line at the end pins
// the message the verifier gives (line and fragment).
// after: Q05.P5v
use vstd::prelude::*;

verus! {

pub struct Locked;

pub struct Counter {
    pub hits: u64,
    pub cap: u64,
}

impl Counter {
    /// `Ok` exactly when there is room for one more hit; changes nothing.
    pub fn check_room(&mut self) -> (r: Result<(), Locked>)
        ensures
            r is Ok <==> old(self).hits < old(self).cap,
            final(self).cap == old(self).cap,
    {
        if self.hits < self.cap {
            Ok(())
        } else {
            Err(Locked)
        }
    }
}

fn client() {
    let mut c = Counter { hits: 5, cap: 5 };
    let r = c.check_room();
    if r.is_err() {
        assert(c.hits == 5);
    }
}

} // verus!
// EXPECT @36 "assertion failed"
