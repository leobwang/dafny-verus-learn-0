// Demo for card Q05.C4d (write:lexicographic-decreases), the failure half: a recursion on
// two arguments with no `decreases` clause. Run it with
// `scripts/vcheck specimens/Q05/card-c4d.dfy.specimen`; the EXPECT line at the end pins
// the message the verifier gives (line and fragment).
// after: Q05.P2dv
module Q05_CardC4d {
  function Steps(a: nat, b: nat): nat
  {
    if b == 0 then a else if a == 0 then Steps(3, b - 1) else Steps(a - 1, b)
  }
}
// EXPECT @9 "cannot prove termination"
