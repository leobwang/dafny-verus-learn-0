// Card Q02.C4d (a `forall` postcondition), the failure demo: CardIndices of the exercise
// file with a body that builds the wrong limbs. Open it only after your Q02 predictions are
// committed.
// EXPECT @8 "a postcondition could not be proved on this return path"
module Q02_CardC4d {
  method CardIndices(n: nat) returns (s: seq<nat>)
    ensures |s| == n && forall i | 0 <= i < n :: s[i] == i
  {
    s := [];
    var k := 0;
    while k < n
      invariant k <= n && |s| == k
      invariant forall i | 0 <= i < k :: s[i] == i + 1
      decreases n - k
    {
      s := s + [k + 1];
      k := k + 1;
    }
  }
}
