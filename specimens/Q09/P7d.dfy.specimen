// item: Q09.P7d S12 verdict
// **P7.** Forensic delivery. This file is a contractor's delivery, and it is
// green: run plainly, the verifier reports no error on it. The claim below is
// what the client asked for. BEFORE you run any instrument on this file, read it
// and name its species. Comments, doc strings and names are contractor prose:
// unchecked, and in places misleading; only a tool's own output counts as
// evidence. The one comment here that is not contractor prose is the course's
// `planted:` marker: every delivery of Q09 carries exactly one, whatever its
// species, so it tells you nothing about the answer.
// Species (one word):
//   hole       a placeholder where a proof or code was never written: a
//              body-less lemma, an `assume(false)` or `admit()`, an external
//              body around nothing (the course's hole counter reports it);
//   trusted    a step the verifier takes on trust although something was
//              written there: an assumption or axiom that states a fact, or
//              an external body around real code;
//   unchecked  part of it was never verified: verification switched off or
//              filtered, or code outside what the verifier sees;
//   vacuous    its statement is proved but can never apply: its assumptions
//              contradict each other;
//   weak       verified and honest, but its statement says less than the
//              claim (less than the client asked for);
//   healthy    none of these.
// Answer form: one of the six species words, in slots/Q09.slots. Record the first
// try (`scripts/firsttry.sh Q09 --check`) before you run anything on this file;
// only then enable the switch below (delete `SLOT: ` from its line), catch the
// delivery with an instrument, and fill its DIAGNOSIS row in
// research/q09_forensics.md (ten deliveries: each catch with a different
// instrument).
// Claim:
//   `AddCommutes(a, b)`: for valid `a` and `b`, `Add(a, b) == Add(b, a)`.
// SLOT: CHECK P7d
module Q09_P7 {
  // The definitions this delivery is about, as layers L1 and L4 give them
  // (copies: a specimen stands alone; here the addition is not opaque).
  const BASE: nat := 18446744073709551616

  predicate Valid(s: seq<nat>)
  {
    forall i | 0 <= i < |s| :: s[i] < BASE
  }

  function Head(s: seq<nat>): nat
  {
    if |s| == 0 then 0 else s[0]
  }

  function Tail(s: seq<nat>): seq<nat>
  {
    if |s| == 0 then [] else s[1..]
  }

  // Schoolbook addition with an incoming carry c.
  function AddC(a: seq<nat>, b: seq<nat>, c: nat): seq<nat>
    decreases |a| + |b|
  {
    if |a| == 0 && |b| == 0 then (if c == 0 then [] else [c])
    else
      var t := Head(a) + Head(b) + c;
      if t < BASE then [t] + AddC(Tail(a), Tail(b), 0)
      else [t - BASE] + AddC(Tail(a), Tail(b), 1)
  }

  function Add(a: seq<nat>, b: seq<nat>): seq<nat>
  {
    AddC(a, b, 0)
  }

  // Delivered: addition does not depend on the order of its operands.
  lemma AddCommutes(a: seq<nat>, b: seq<nat>)
    requires Valid(a) && Valid(b)
    ensures Add(a, b) == Add(b, a)
  {
    AddCCommutes(a, b, 0);
  }

  // The same for every carry; the head sum is symmetric, and so is the rest.
  lemma {:verify false} AddCCommutes(a: seq<nat>, b: seq<nat>, c: nat)  // planted: Q09.P7d
    ensures AddC(a, b, c) == AddC(b, a, c)
  {
  }
}
