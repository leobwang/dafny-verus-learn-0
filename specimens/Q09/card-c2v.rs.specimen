// Demo for card Q09.C2v (write:trigger-rewrite), the failure half. The success half is
// `lemma_zeros_nonempty` in verus/q/q09_internals_iii/src/lib.rs; here the same step is
// triggered on `zeros(k)`, the term each of its instances creates anew. Run it with
// `scripts/vcheck specimens/Q09/card-c2v.rs.specimen` (and `--json` for its rlimit count);
// the EXPECT line pins the message the verifier gives (line and fragment).
// after: Q09.P2dv
// EXPECT @32 "postcondition not satisfied"
use vstd::prelude::*;

verus! {

#[verifier::opaque]
pub open spec fn zeros(n: nat) -> Seq<u64>
    decreases n,
{
    if n == 0 {
        Seq::<u64>::empty()
    } else {
        zeros((n - 1) as nat).push(0)
    }
}

pub proof fn lemma_zeros_succ(k: nat)
    ensures
        zeros(k + 1).len() == zeros(k).len() + 1,
{
    reveal(zeros);
}

pub proof fn lemma_zeros_nonempty(m: nat)
    ensures
        zeros(m + 1).len() > 0,
{
    assert forall|k: nat| zeros(k + 1).len() == #[trigger] zeros(k).len() + 1 by {
        lemma_zeros_succ(k);
    }
}

} // verus!
