// Companion of specimens/Q09/P9d.dfy.specimen: the statement the client froze, for
// `scripts/specfreeze --against specimens/Q09/P9d-frozen.dfy.specimen
// specimens/Q09/P9d.dfy.specimen`. The lemma has no body: the delivery fills it. Open it
// only after P9d's first try is recorded.
// after: Q09.P9d
module Q09_P9 {
  function Head(s: seq<nat>): nat
  {
    if |s| == 0 then 0 else s[0]
  }

  function Tail(s: seq<nat>): seq<nat>
  {
    if |s| == 0 then [] else s[1..]
  }

  // Three-way comparison of two limb sequences: -1, 0 or 1.
  function Cmp(a: seq<nat>, b: seq<nat>): int
    decreases |a| + |b|
  {
    if |a| == 0 && |b| == 0 then 0
    else
      var c := Cmp(Tail(a), Tail(b));
      if c != 0 then c
      else if Head(a) < Head(b) then -1
      else if Head(a) > Head(b) then 1
      else 0
  }

  lemma CmpSelf(a: seq<nat>)
    ensures Cmp(a, a) == 0
    decreases |a|
}
