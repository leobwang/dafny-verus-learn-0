use vstd::prelude::*;
use rg_re_a4::*;
verus! {
// A root bound/progress model only, not full pattern/word certificate validity.
pub open spec fn root_split_ok_r11(d:Derivation,n:nat)->bool {
 match d {
  Derivation::DCat(k,_,_)=>k<=n,
  Derivation::DStarCons(k,_,_)=>0<k<=n,
  _=>true,
 }
}
