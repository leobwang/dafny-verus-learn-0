// CHECK P13v
use vstd::prelude::*;
use qg_bignat_l4::*;

verus! {

// Delivered: a canonical non-empty sequence weighs at least its top limb's weight.
pub proof fn lemma_top_limb(s: Seq<u64>)
    requires
        seq_wf(s),
        s.len() > 0,
        s.last() == 0,  // planted: Q09.P13v
    ensures
        seq_to_nat(s) >= weight((s.len() - 1) as nat),
{
