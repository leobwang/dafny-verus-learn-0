// item: Q01.P6v S1 value
// **P6v.** What value does `seq_to_nat` give for the two-limb sequence `[1, 3]` (least
// significant limb first)? Verus evaluates the assertion in its interpreter
// (`by (compute_only)`) instead of proving it with the solver.
// Answer form: numeral
// Reference twin: the check is enabled with the captured value, 1 + 3 * 2^64, and run by
// `scripts/pins.py --ref`.
use vstd::prelude::*;
use qg_bignat_l1::*;

verus! {

proof fn p6v() {
    assert(seq_to_nat(seq![1u64, 3u64]) == 55340232221128654849) by (compute_only);
}

} // verus!
