// item: Q03.P3d S7 obligation
// **P3.** Subset types (Reference Solution: [b] is BASE itself, not below it;
// [d] can reach 2 * BASE - 2, so `x + y` need not be a limb; [a] and [c] are
// constants below BASE). `Limb` is the subset type of the naturals below BASE.
// Each method below assigns one value to a `Limb` variable, on the line
// labelled `// [x]`. Which labelled assignments does the verifier fail to
// prove? Answer form: `FAILS` followed by the failing labels in label order,
// separated by single spaces, or `FAILS none`.
// FAILS b d
module Q03_P3 {
  const BASE: nat := 18446744073709551616

  type Limb = x: nat | x < BASE

  method AssignA() {
    var l: Limb := BASE - 1;  // [a]
  }

  method AssignB() {
    var l: Limb := BASE;  // [b]
  }

  method AssignC() {
    var l: Limb := 5 + 5;  // [c]
  }

  method AssignD(x: Limb, y: Limb) {
    var l: Limb := x + y;  // [d]
  }
}
