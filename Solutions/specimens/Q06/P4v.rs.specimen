// item: Q06.P4v S11 obligation
// **P4.** Triggers, in Verus (Reference Solution: [b]'s goal mentions no `weight` term,
// so the hypothesis never fires; [a] and [d] mention `weight(k)` and `weight(2)`. In [c]
// the goal's prefix matches the trigger, so the hypothesis gives the bound `weight(2)`,
// but `weight` is opaque: nothing here says `weight(2) == BASE * BASE`, so [c] fails too,
// unlike Dafny's transparent `Pow` in P3). The same four, over `seq_to_nat`, `subrange`
// and layer L3's `weight`: each proof fn has the same hypothesis, that every prefix of `s`
// is below a weight, with an explicit trigger, and an empty body. Which labelled
// postconditions does the verifier fail to prove?
// Answer form: `FAILS` followed by the failing labels in label order, separated by single
// spaces, or `FAILS none`.
// FAILS b c
use vstd::prelude::*;
use qg_bignat_l3::*;

verus! {

proof fn bound_at_k(s: Seq<u64>, k: nat)
    requires
        forall|i: nat| i <= s.len() ==> seq_to_nat(s.subrange(0, i as int)) < #[trigger] weight(i),
        k <= s.len(),
    ensures
        seq_to_nat(s.subrange(0, k as int)) < weight(k),  // [a]
{
}

proof fn two_limbs_product(s: Seq<u64>)
    requires
        forall|i: nat| i <= s.len() ==> seq_to_nat(s.subrange(0, i as int)) < #[trigger] weight(i),
        s.len() >= 2,
    ensures
        seq_to_nat(s.subrange(0, 2)) < BASE * BASE,  // [b]
{
}

proof fn two_limbs_product_prefix_trigger(s: Seq<u64>)
    requires
        forall|i: nat| i <= s.len() ==> seq_to_nat(#[trigger] s.subrange(0, i as int)) < weight(i),
        s.len() >= 2,
    ensures
        seq_to_nat(s.subrange(0, 2)) < BASE * BASE,  // [c]
{
}

proof fn two_limbs_weight(s: Seq<u64>)
    requires
        forall|i: nat| i <= s.len() ==> seq_to_nat(s.subrange(0, i as int)) < #[trigger] weight(i),
        s.len() >= 2,
    ensures
        seq_to_nat(s.subrange(0, 2)) < weight(2),  // [d]
{
}

} // verus!
