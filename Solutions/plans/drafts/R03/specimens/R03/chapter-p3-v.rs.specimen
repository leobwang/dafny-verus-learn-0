// after: R03.P3dv
// Scenario exposes range fields so the open view is well-formed;
// the executable constructor retains only its validity postcondition.
use vstd::prelude::*;
verus! {
pub mod api {
use vstd::prelude::*;
pub struct CharClass { pub ranges: Vec<(char,char)>, }
impl View for CharClass {
    type V=ISet<char>;
    closed spec fn view(&self) -> ISet<char> {
        ISet::new(|c: char| exists|i: int| 0 <= i < self.ranges@.len() &&
            self.ranges@[i].0 <= c && c <= self.ranges@[i].1)
    }
}
impl CharClass {
    pub closed spec fn valid(&self) -> bool {
        forall|i: int| 0 <= i < self.ranges@.len() ==>
            (#[trigger] self.ranges@[i]).0 <= self.ranges@[i].1
    }
    pub fn class_single(c: char) -> (r: CharClass)
        ensures r.valid(),
    { let mut rs=Vec::new(); rs.push((c,c)); CharClass { ranges: rs } }
}
}
pub mod client {
use vstd::prelude::*; use super::api::CharClass;
fn check() { let cc=CharClass::class_single('b'); assert(cc@.contains('b')); }
}
}
